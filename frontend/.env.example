# SentinelFlow dashboard — frontend environment

# Use the in-repo mock layer (true) or call the real backends (false).
VITE_USE_MOCKS=true

# Real backend base URLs (used only when VITE_USE_MOCKS=false). See docs/api-contract.md.
VITE_API_BASE_URL=http://localhost:8080
VITE_AGENT_API_URL=http://localhost:8000

# Default auto-refresh interval for live data, milliseconds.
VITE_POLL_INTERVAL_MS=5000
