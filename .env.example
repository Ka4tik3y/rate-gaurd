RATE_LIMIT_ENABLED=true
RATE_LIMIT_DEFAULT_CAPACITY=100
RATE_LIMIT_DEFAULT_REFILL_RATE=10
RATE_LIMIT_REDIS_FAILURE_MODE=FAIL_OPEN
DOWNSTREAM_URL=http://httpbin.org

# Phase 2 - metrics & anomaly detection
TRAFFIC_METRICS_ENABLED=true
ANOMALY_ENABLED=true
ANOMALY_INTERVAL_SECONDS=60
ANOMALY_EVALUATION_WINDOW_MINUTES=5

# Phase 3 - policy gate kill switch & guardrails
AGENT_ENABLED=true
POLICY_GATE_MAX_CHANGE_RATIO=0.5
POLICY_GATE_MAX_BLOCK_SECONDS=3600
POLICY_GATE_COOLDOWN_SECONDS=60

# Phase 3 - admin/agent API credentials (CHANGE THESE; never commit real secrets)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin
AGENT_USERNAME=agent
AGENT_PASSWORD=agent

# Phase 4 - AI agent (ai-agent service)
# AGENT_LLM_PROVIDER: auto (Claude if ANTHROPIC_API_KEY set, else deterministic heuristic) | anthropic | heuristic
AGENT_LLM_PROVIDER=auto
ANTHROPIC_API_KEY=
AGENT_ANTHROPIC_MODEL=claude-opus-5-5
AGENT_OUTCOME_WAIT_SECONDS=10
AGENT_EVALUATION_WINDOW_MINUTES=5
